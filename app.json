{
  "expo": {
    "name": "Native AI",
    "slug": "native-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "myai",
    "splash": {
      "image": "./assets/SplashIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundColor": "#0f0f1a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.myai.app"
    },
    "web": {
      "favicon": "./assets/AppIcon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-document-picker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36a8fa6d-5690-4cce-b241-7a2dcf0714f3"
      }
    },
    "owner": "shivnandansoni"
  }
}
